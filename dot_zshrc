function git_list_and_checkout() {
  local branch current
  current=$(git branch --show-current)
  branch=$(
    {
      git for-each-ref --format='local/%(refname:short)' refs/heads
      git for-each-ref --format='remote/%(refname:short)' refs/remotes | grep -v 'HEAD'
    } |
    sort -u |
    awk -v current="$current" '
      {
        name=$0
        sub(/^local\//, "", name)
        if (name == current) {
          printf "\033[1;32m%s (current)\033[0m\n", $0
        } else {
          print $0
        }
      }
    ' |
    fzf --ansi \
        --height 40% --layout=reverse --border \
        --prompt=" Branch > " \
        --preview 'b=$(echo {} | sed "s# (current)##; s#^local/##; s#^remote/[^/]*/##"); git log --oneline --graph --decorate --color=always "$b" | head -20'
  )

  # Clean selection — strip remote name as well
  branch=$(echo "$branch" | sed 's# (current)##; s#^local/##; s#^remote/[^/]*/##')
  [ -n "$branch" ] && git switch "$branch"
}
alias gco="git_list_and_checkout"

function git_browse() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
        echo "Not inside a Git repository."
        return 1
    }

    local url host repo_path

    url=$(git remote get-url origin)

    if [[ "$url" =~ ^git@([^:]+):(.+)$ ]]; then
        host="${match[1]}"
        repo_path="${match[2]}"
        url="https://${host}/${repo_path}"
    fi

    url="${url%.git}"

    open "$url"
}
alias gb="git_browse"

# Create a symlink in the current directory
function mksym() {
  if [[ -z "$1" || -z "$2" ]]; then
    echo "Usage: mksym <target> <symlink-name>"
    return 1
  fi
  ln -s "$1" "$(pwd)/$2" && echo "✓ Symlink '$2' → '$1' created in $(pwd)"
}
alias mksym="mksym"

# Remove a symlink in the current directory using fzf
function rmsym() {
  local selected
  selected=$(find . -maxdepth 1 -type l | sed 's|./||' | \
    fzf --height 40% --layout=reverse --border \
        --prompt=" Symlink > " \
        --preview 'readlink {}')
  if [[ -n "$selected" ]]; then
    rm "$selected" && echo "✓ Symlink '$selected' removed"
  else
    echo "No symlink selected."
  fi
}
alias rmsym="rmsym"

# Shortcut to symlink an app by name only
linkapp() {
  local app_name="$1"
  # This adds .app if you forget to type it
  [[ "$app_name" != *.app ]] && app_name="$app_name.app"

  sudo ln -s "/Volumes/External/Applications/$app_name" "/Applications/$app_name"
  
  echo "Successfully linked $app_name from External to Applications!"
}
